{
    "name": "kitzberger/cakephp-markdown",
    "description": "Cakephp Markdown plugin for CakePHP 5.x",
    "license": "MIT",
    "type": "cakephp-plugin",
    "authors": [
        {
            "name": "Tanuck",
            "email": "tanuck@gmail.com"
        },
        {
            "name": "Philipp Kitzberger",
            "email": "coding@kitze.net"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.4",
        "cakephp/plugin-installer": "^2.0",
        "cebe/markdown": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.1 || ^13.0",
        "cakephp/cakephp-codesniffer": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "Tanuck\\Markdown\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tanuck\\Markdown\\Test\\": "tests",
            "Cake\\Test\\": "./vendor/cakephp/cakephp/tests"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
